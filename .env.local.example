# Copy to .env.local and set your values.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.3
XAI_REASONING_EFFORT=none
# Set false to pause model calls while keeping finished cached pages available.
ARTICLE_GENERATION_ENABLED=true
XAI_API_BASE_URL=https://api.x.ai/v1
REWRITE_PORT=8787

# Optional frontend override
VITE_REWRITE_API_URL=http://127.0.0.1:8787/api/rewrite
VITE_ARTICLE_API_URL=http://127.0.0.1:8787/api/article

# Optional: ntfy.sh topic for notifications
# NTFY_TOPIC=your-secret-topic-name         (bulk processor)
# Notifications are server/bulk-only; no topic is published in the website.
